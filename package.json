{
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "lint": "npm run lint --workspace=client",
    "typecheck": "npm run typecheck --workspace=client",
    "test": "npm run test --workspace=server",
    "seed:admin": "npm run seed:admin --workspace=server",
    "seed:content": "npm run seed:content --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
