NODE_ENV=development
PORT=5000

CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/shaivis_little_world

JWT_ACCESS_SECRET=your_long_random_access_secret
JWT_REFRESH_SECRET=your_different_long_random_refresh_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_ACCESS_NAME=shaivi_access
COOKIE_REFRESH_NAME=shaivi_refresh

BCRYPT_ROUNDS=12

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=shaivis-little-world

MAX_IMAGE_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=50

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

